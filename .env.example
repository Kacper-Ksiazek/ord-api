### Spring
PORT=8080
SPRING_PROFILE=local

### CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

### Database
DATABASE_URL=

### Docker Compose Database Credentials
DOCKER_DB_NAME=ord_db
DOCKER_DB_USER=ord_user
DOCKER_DB_PASSWORD=ord_password

### SMTP
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

### JWT
JWT_SECRET_KEY=

### OpenAI
OPEN_AI_KEY=

### ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

### OTP whitelist (E2E worker accounts — seeded by Flyway V22 in all envs)
# Emails: e2e-ci-w0@ord.test … e2e-ci-w3@ord.test
OTP_WHITELISTED_EMAILS=e2e-ci-w0@ord.test,e2e-ci-w1@ord.test,e2e-ci-w2@ord.test,e2e-ci-w3@ord.test

# Local / docker-compose.e2e.yml — simple code OK
OTP_CODE_FOR_WHITELISTED_EMAILS=123456

# Production — set in host secrets only; generate once:
#   python3 -c "import random; print(f'{random.randint(0, 999999):06d}')"
# OTP_CODE_FOR_WHITELISTED_EMAILS=<6-digit secret>

### E2E runtime seeder (optional repair; Flyway V22 is primary)
E2E_SEEDER_ENABLED=false
E2E_WORKER_COUNT=4
E2E_EMAIL_PREFIX=e2e-ci-w
E2E_EMAIL_DOMAIN=ord.test

### Misc
ENV_TEST_PROPERTY=1test1