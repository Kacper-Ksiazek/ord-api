meta {
  name: Create QAW
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/quickly-added-words/
  body: json
  auth: inherit
}


headers {
  Content-Type: application/json
}

body:json {
{
  "word": "serendipity",
  "language": "ENGLISH"
}
}

script:post-response {
  const body = res.getBody();
  if (body?.id) {
    bru.setEnvVar("qawId", body.id);
  }
}
