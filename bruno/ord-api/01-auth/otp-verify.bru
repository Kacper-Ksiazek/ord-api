meta {
  name: OTP Verify
  type: http
  seq: 2
}

docs {
  Sets AUTH-TOKEN cookie in Bruno cookie jar.
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/otp-verify
  body: json
  auth: none
}


headers {
  Content-Type: application/json
}

body:json {
{
  "email": "{{email}}",
  "code": "{{otpCode}}"
}
}

script:post-response {
  const body = res.getBody();
  if (body?.id) {
    bru.setEnvVar("userId", body.id);
  }
}
