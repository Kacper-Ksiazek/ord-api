meta {
  name: Suggest Topics (SSE)
  type: http
  seq: 1
}

docs {
  SSE stream of AI-generated topic suggestions.

  Requires login and `OPEN_AI_KEY` on the API.
}

post {
  url: {{baseUrl}}{{apiPrefix}}/conversations/suggest-topics
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: text/event-stream
}

body:json {
  {
    "clueFromUser": "travel and holidays",
    "conversationType": "SMALL_TALK",
    "language": "ENGLISH",
    "excludeTopics": []
  }
}

script:post-response {
  test("stream started", () => {
    expect(res.getStatus()).to.equal(200);
  });
}
