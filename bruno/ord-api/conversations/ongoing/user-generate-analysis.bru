meta {
  name: Generate User Message Analysis
  type: http
  seq: 5
}

docs {
  AI grammar and language analysis for an existing user message.
}

post {
  url: {{baseUrl}}{{apiPrefix}}/conversations/ongoing/user/generate-analysis
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "conversationId": "{{conversationId}}",
    "messageId": "00000000-0000-0000-0000-000000000001",
    "messageOrder": 1,
    "latestAIMessage": null
  }
}

script:post-response {
  test("analysis generated", () => {
    expect(res.getStatus()).to.equal(200);
  });
}
