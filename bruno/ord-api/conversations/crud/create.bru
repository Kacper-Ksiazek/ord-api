meta {
  name: Create Conversation
  type: http
  seq: 3
}

docs {
  Creates a conversation session. Sets `conversationId` for ongoing endpoints.

  Sample body also lives in `_fixtures/bodies/create-conversation.json`.
}

post {
  url: {{baseUrl}}{{apiPrefix}}/conversations/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "topic": "Discussing the weather and climate change",
    "additionalContext": "Focus on environmental impact",
    "language": "ENGLISH",
    "tone": "FRIENDLY",
    "type": "SMALL_TALK",
    "aiInterlocutorName": "Dr. Smith",
    "aiInterlocutorAvatarId": "AVATAR_ALPHA"
  }
}

script:post-response {
  test("created", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();
  test("conversation shape", () => {
    expect(body.id).to.be.a("string");
    expect(body.topic).to.be.a("string");
    expect(body.language).to.equal("ENGLISH");
  });

  if (body?.id) {
    bru.setEnvVar("conversationId", body.id);
  }
}
